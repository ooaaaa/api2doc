{
  "name": "api2doc",
  "version": "2.0.6",
  "description": "美观的 API 文档查看器，支持 Swagger/OpenAPI，内置代理解决跨域",
  "type": "module",
  "bin": {
    "api2doc": "cli/index.js"
  },
  "files": [
    "cli/",
    "dist/"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "node api/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node cli/index.js",
    "type-check": "vue-tsc --noEmit"
  },
  "keywords": [
    "api",
    "documentation",
    "swagger",
    "openapi",
    "cli",
    "proxy"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ooaaaa/api2doc.git"
  },
  "dependencies": {
    "@codemirror/legacy-modes": "^6.5.2",
    "sirv": "^3.0.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.8",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "ant-design-vue": "^4.1.0",
    "codemirror": "^6.0.2",
    "marked": "^17.0.1",
    "terser": "^5.44.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^3.1.6"
  }
}
